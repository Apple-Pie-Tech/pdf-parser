# Qdrant (read by qdrant-loader / vector_store.py via config.Settings)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=apple_pie_story_chunks
# Attributed to points written by qdrant-loader when `qdrant-loader load` is run
# without --user-id. pdf-parser ingests documents rather than acting on behalf
# of an end user, so this identifies the ingestion pipeline itself.
DEFAULT_USER_ID=pdf-parser

# Azure OpenAI embeddings (shared by txt-chunker and qdrant-loader via config.Settings)
AZURE_OPENAI_ENDPOINT=https://example.invalid/openai/v1/
AZURE_OPENAI_API_KEY=fake-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Semantic chunking (txt-chunker only)
# Chonkie similarity threshold for splitting sentences into a new chunk (0-1).
SEMANTIC_SIMILARITY_THRESHOLD=0.8
# Number of trailing sentences carried over as overlap context into the next chunk.
CHUNK_OVERLAP_SENTENCES=1
# Chunks shorter than this are merged into a neighboring chunk.
MIN_CHUNK_CHARS=350
# Chonkie's max chunk size, in characters.
MAX_CHUNK_CHARS=1400
